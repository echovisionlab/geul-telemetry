{
  "name": "@echovisionlab/geul-telemetry",
  "version": "0.1.3",
  "private": false,
  "description": "Shared logging, tracing, audit, security, request-correlation, and redaction contracts for Geul services.",
  "author": "state303 <state303@dsub.io>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echovisionlab/geul-telemetry.git"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "files": [
    "README.md",
    "src",
    "!src/**/*.test.ts",
    "fixtures",
    "policy"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "deadcode": "knip --include files,dependencies,unlisted,exports,types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package:smoke": "npm pack --dry-run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./actor": "./src/actor.ts",
    "./redaction": "./src/redaction.ts",
    "./request-id": "./src/request-id.ts",
    "./trace": "./src/trace.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/echovisionlab/geul-telemetry#readme",
  "bugs": {
    "url": "https://github.com/echovisionlab/geul-telemetry/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
